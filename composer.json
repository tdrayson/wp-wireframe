{
    "name": "tdrayson/wp-wireframe",
    "description": "A fast, standardised way to build WordPress settings pages from a PHP array.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "magewirephp/validation": "^1.0"
    },
    "autoload": {
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Wireframe\\": "tests/"
        },
        "classmap": [
            "tests/"
        ]
    },
    "keywords": ["wordpress", "settings", "admin", "framework", "react"],
    "archive": {
        "exclude": [
            "/docs",
            "/examples",
            "/js",
            "/node_modules",
            "/.github",
            "/.gitignore",
            "/CHANGELOG.md",
            "/package.json",
            "/package-lock.json",
            "/phpunit.xml",
            "/tests"
        ]
    },
    "require-dev": {
        "10up/wp_mock": "^1.1"
    }
}
