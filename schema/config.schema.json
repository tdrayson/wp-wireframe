{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tdrayson/wp-wireframe/main/schema/config.schema.json",
  "title": "WP Wireframe page config",
  "description": "Schema for a WP Wireframe page config — the array returned from a config file or passed inline to App::boot(). Accepts any of the three input formats normalized by ConfigLoader::normalize(): fields-only, sections-only, or full tabs.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Optional page title rendered above the form."
    },
    "subtitle": {
      "type": "string",
      "description": "Optional page subtitle rendered under the title."
    },
    "header_actions": {
      "type": "array",
      "description": "Buttons rendered in the page header next to Save/Reset. With `href` a button is a link; without, it POSTs the form values to the `{prefix}/header_action/{pageId}/{id}` filter.",
      "items": { "$ref": "#/$defs/headerAction" }
    },
    "tabs": {
      "type": "array",
      "description": "Full-tabs format: top-level tabs, each containing sections of fields.",
      "items": { "$ref": "#/$defs/tab" }
    },
    "sections": {
      "type": "array",
      "description": "Sections-only format: sections wrapped in a single default tab.",
      "items": { "$ref": "#/$defs/section" }
    },
    "fields": {
      "type": "array",
      "description": "Fields-only format: fields wrapped in a single default section and tab.",
      "items": { "$ref": "#/$defs/field" }
    }
  },
  "oneOf": [
    {
      "required": ["tabs"],
      "not": { "anyOf": [{ "required": ["sections"] }, { "required": ["fields"] }] }
    },
    {
      "required": ["sections"],
      "not": { "anyOf": [{ "required": ["tabs"] }, { "required": ["fields"] }] }
    },
    {
      "required": ["fields"],
      "not": { "anyOf": [{ "required": ["tabs"] }, { "required": ["sections"] }] }
    }
  ],
  "$defs": {
    "tab": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Unique tab identifier." },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "access": { "$ref": "#/$defs/access" },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        }
      }
    },
    "section": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Unique section identifier." },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "access": { "$ref": "#/$defs/access" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Unique field identifier; the key used to store and read its value." },
        "type": {
          "type": "string",
          "description": "Field type slug. The values below are the built-in types; custom types registered via the `wp-wireframe/field_types` filter are also valid but not enumerated here.",
          "enum": [
            "text", "textarea", "email", "url", "password", "hidden",
            "number", "range", "select", "radio", "image_radio",
            "checkboxes", "image_checkboxes", "toggle", "checkbox",
            "color", "date", "time", "editor", "code_editor", "file",
            "repeater", "html", "export", "import", "table", "action"
          ]
        },
        "label": { "type": "string", "description": "Visible field label." },
        "title": { "type": "string" },
        "description": { "type": "string", "description": "Help text shown under the field. Supports {field_id} interpolation." },
        "default": { "description": "Default value used until the user saves one. Shape depends on the field type." },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "Grid width out of 12 columns."
        },
        "required": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "validation": {
          "type": "string",
          "description": "Rakit validation rules string, e.g. \"min:3|max:100\"."
        },
        "access": { "$ref": "#/$defs/access" },
        "conditions": { "$ref": "#/$defs/conditionNode" },
        "public": {
          "type": "boolean",
          "description": "Post fields only: include the value in public (view context) REST responses. Default false."
        },
        "column": {
          "description": "Post fields only, on a storable field: show it as a column on the post type's admin list. `true`, or an object.",
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "properties": {
                "label": { "type": "string", "description": "Column heading. Defaults to the field label." },
                "sortable": { "type": "boolean", "description": "Let the list be sorted by this column. Ignored for multi-value fields and repeaters." },
                "after": { "type": "string", "description": "Id of the column to follow. Defaults to `title`; field columns are `wireframe_{field_id}`." }
              },
              "additionalProperties": false
            }
          ]
        },
        "indexed": {
          "type": "boolean",
          "description": "Repeater subfields on post fields only: write the value to the index table so `wireframe_query` can match it."
        },
        "args": {
          "type": "object",
          "description": "Type-specific options. Keys vary by `type`; see the per-type constraints."
        }
      },
      "allOf": [
        { "$ref": "#/$defs/argsByType/choice" },
        { "$ref": "#/$defs/argsByType/imageChoice" },
        { "$ref": "#/$defs/argsByType/repeater" },
        { "$ref": "#/$defs/argsByType/table" },
        { "$ref": "#/$defs/argsByType/html" },
        { "$ref": "#/$defs/argsByType/number" },
        { "$ref": "#/$defs/argsByType/range" },
        { "$ref": "#/$defs/argsByType/color" }
      ]
    },
    "headerAction": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$", "description": "Action identifier; the last segment of the hook name." },
        "label": { "type": "string" },
        "variant": { "type": "string", "enum": ["primary", "secondary", "tertiary", "link"] },
        "destructive": { "type": "boolean" },
        "href": { "type": "string", "description": "Render as a link to this URL instead of dispatching." },
        "target": { "type": "string", "description": "Link target, e.g. `_blank`. Only used with `href`." },
        "confirm": {
          "description": "Confirm step before dispatching: a message string, or an object overriding the dialog copy.",
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "message": { "type": "string" },
                "title": { "type": "string" },
                "button_label": { "type": "string" },
                "cancel_label": { "type": "string" }
              }
            }
          ]
        },
        "access": { "$ref": "#/$defs/access" }
      }
    },
    "access": {
      "description": "Role/capability access rule. A string or list applies to both view and edit; an object splits them. Strings match a role slug first, then a capability. Arrays are OR.",
      "oneOf": [
        { "$ref": "#/$defs/accessValue" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "view": { "$ref": "#/$defs/accessValue" },
            "edit": { "$ref": "#/$defs/accessValue" }
          }
        }
      ]
    },
    "accessValue": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      ]
    },
    "conditionNode": {
      "type": "object",
      "description": "Conditional show/hide rule. Either a combinator (`all`/`any`) or a single rule (`field` + `operator` + optional `value`).",
      "additionalProperties": false,
      "properties": {
        "all": { "type": "array", "items": { "$ref": "#/$defs/conditionNode" } },
        "any": { "type": "array", "items": { "$ref": "#/$defs/conditionNode" } },
        "field": { "type": "string" },
        "operator": {
          "type": "string",
          "enum": [
            "equals", "not_equals", "truthy", "falsy", "in", "not_in",
            "between", "starts_with", "ends_with", "contains", "not_contains",
            "is_empty", "is_not_empty", "gt", "gte", "lt", "lte"
          ]
        },
        "value": true
      }
    },
    "optionMap": {
      "type": "object",
      "description": "Map of stored value → display label. Image variants may pair each value with an object carrying an image URL.",
      "minProperties": 1,
      "additionalProperties": {
        "type": ["string", "object"]
      }
    },
    "populate": {
      "type": "object",
      "description": "Select, checkboxes and radio only: options filled from posts, users, terms or a callback, merged with the static `options`.",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["query", "function", "custom"], "description": "Default `query`." },
        "query": { "type": "string", "enum": ["posts", "users", "terms"], "description": "Default `posts`. Runs WP_Query, WP_User_Query or WP_Term_Query." },
        "arguments": { "type": "object", "description": "Query args. Defaults: published posts by title, all of them; users by display name; empty terms included." },
        "return_format": {
          "type": "object",
          "additionalProperties": false,
          "description": "Object properties for each option. Defaults: ID/post_title, ID/display_name, term_id/name.",
          "properties": {
            "value": { "type": "string" },
            "label": { "type": "string" }
          }
        },
        "function": { "type": "string", "description": "Type `function`: a callable name (a closure in PHP config), called with the field; returns a value => label map." },
        "custom": { "type": "string", "description": "Type `custom`: id of the `wp-wireframe/populate/{id}` filter that returns a value => label map." },
        "position": { "type": "string", "enum": ["before", "after"], "description": "Where populated options go relative to the static `options`. Default `after`." },
        "fetch": { "type": "boolean", "description": "Select only: ship just the stored labels and search as you type." }
      }
    },
    "argsByType": {
      "choice": {
        "if": {
          "properties": {
            "type": {
              "enum": ["select", "radio", "checkboxes"]
            }
          },
          "required": ["type"]
        },
        "then": {
          "properties": {
            "args": {
              "type": "object",
              "anyOf": [{ "required": ["options"] }, { "required": ["populate"] }],
              "properties": {
                "options": { "$ref": "#/$defs/optionMap" },
                "populate": { "$ref": "#/$defs/populate" },
                "multiple": { "type": "boolean" },
                "allow_custom": { "type": "boolean" },
                "placeholder": { "type": "string" },
                "max": { "type": "integer" }
              }
            }
          },
          "required": ["args"]
        }
      },
      "imageChoice": {
        "if": {
          "properties": {
            "type": {
              "enum": ["image_radio", "image_checkboxes"]
            }
          },
          "required": ["type"]
        },
        "then": {
          "properties": {
            "args": {
              "type": "object",
              "required": ["options"],
              "not": { "required": ["populate"] },
              "properties": {
                "options": { "$ref": "#/$defs/optionMap" },
                "multiple": { "type": "boolean" },
                "allow_custom": { "type": "boolean" },
                "placeholder": { "type": "string" },
                "max": { "type": "integer" }
              }
            }
          },
          "required": ["args"]
        }
      },
      "repeater": {
        "if": {
          "properties": { "type": { "const": "repeater" } },
          "required": ["type"]
        },
        "then": {
          "properties": {
            "args": {
              "type": "object",
              "required": ["subfields"],
              "properties": {
                "subfields": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/field" }
                },
                "sortable": { "type": "boolean" },
                "collapsible": { "type": "boolean" },
                "collapsed": { "type": "boolean" },
                "duplicate_row": { "type": "boolean" },
                "add_row": { "type": "boolean" },
                "delete_row": { "type": "boolean" },
                "min_rows": { "type": "integer", "minimum": 0 },
                "max_rows": { "type": "integer", "minimum": 1 },
                "add_label": { "type": "string" },
                "empty_message": { "type": "string" },
                "title_template": { "type": "string" }
              }
            }
          },
          "required": ["args"]
        }
      },
      "table": {
        "if": {
          "properties": { "type": { "const": "table" } },
          "required": ["type"]
        },
        "then": {
          "properties": {
            "args": {
              "type": "object",
              "required": ["fields"],
              "properties": {
                "fields": {
                  "type": "array",
                  "description": "Column definitions.",
                  "items": {
                    "type": "object",
                    "required": ["id"],
                    "properties": {
                      "id": { "type": "string" },
                      "label": { "type": "string" },
                      "type": { "type": "string" },
                      "sortable": { "type": "boolean" },
                      "searchable": { "type": "boolean" },
                      "elements": { "type": "object" }
                    }
                  }
                },
                "data_callback": { "type": "string", "description": "Name of a PHP callable returning the rows." },
                "per_page": { "type": "integer", "minimum": 1 },
                "search": { "type": "boolean" },
                "actions": { "type": "array", "items": { "type": "object" } },
                "detail_view": { "type": "object" }
              }
            }
          },
          "required": ["args"]
        }
      },
      "html": {
        "if": {
          "properties": { "type": { "const": "html" } },
          "required": ["type"]
        },
        "then": {
          "properties": {
            "args": {
              "type": "object",
              "required": ["content"],
              "properties": {
                "content": { "type": "string" },
                "variant": {
                  "type": "string",
                  "enum": ["plain", "info", "success", "warning", "error"]
                }
              }
            }
          },
          "required": ["args"]
        }
      },
      "number": {
        "if": {
          "properties": { "type": { "const": "number" } },
          "required": ["type"]
        },
        "then": {
          "properties": {
            "args": {
              "type": "object",
              "properties": {
                "min": { "type": "number" },
                "max": { "type": "number" },
                "step": { "type": "number" },
                "integer": { "type": "boolean" },
                "placeholder": { "type": "string" },
                "readonly": { "type": "boolean" },
                "copyable": { "type": "boolean" }
              }
            }
          }
        }
      },
      "range": {
        "if": {
          "properties": { "type": { "const": "range" } },
          "required": ["type"]
        },
        "then": {
          "properties": {
            "args": {
              "type": "object",
              "properties": {
                "min": { "type": "number" },
                "max": { "type": "number" },
                "step": { "type": "number" },
                "suffix": { "type": "string" },
                "allowReset": { "type": "boolean" },
                "marks": { "type": ["array", "object", "boolean"] }
              }
            }
          }
        }
      },
      "color": {
        "if": {
          "properties": { "type": { "const": "color" } },
          "required": ["type"]
        },
        "then": {
          "properties": {
            "args": {
              "type": "object",
              "properties": {
                "enableAlpha": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
